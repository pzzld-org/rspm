#!/usr/bin/env bash
# pre-push: run the Dagger gates, then dispatch to open-sprint-pr.
#
# The gates are `dagger check`: fmt, clippy, nextest, doctests and build from the shared
# pzzld-org/dagger rust module (dagger.toml). They replace the cargo-build, cargo-test and
# cargo-clippy pull_request workflows (pzzld-org/root CI.md). A failing gate refuses the push.
#
# NOT ENABLED BY DEFAULT. This file does nothing until someone sets
#   git config core.hooksPath .githooks
# which is LOCAL config and cannot be committed. Turning it on also lets open-sprint-pr open a
# draft PR on GitHub, so it is the operator's switch to throw, not something a clone inherits.
#
# open-sprint-pr runs here because it needs the branch to exist remotely (git ls-remote), so the
# first push of a sprint branch skips and later pushes open the draft. git has no post-push hook.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPRINT_PR="$HOOK_DIR/open-sprint-pr"
ZERO=0000000000000000000000000000000000000000

updates=$(mktemp)
trap 'rm -f "$updates"' EXIT
cat > "$updates"

# dagger check gates the working tree, so that tree must be exactly the commit being pushed.
head=$(git rev-parse HEAD)
gate=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue
  commit=$(git rev-parse "$local_sha^{commit}")
  if [[ "$commit" != "$head" ]]; then
    echo "pre-push: pushing $commit but HEAD is $head; check out the pushed commit so dagger check gates it." >&2
    exit 1
  fi
  gate=true
done < "$updates"

if $gate; then
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "pre-push: uncommitted changes; dagger check would gate them, not the pushed commit. Commit or stash first." >&2
    exit 1
  fi
  command -v dagger >/dev/null 2>&1 || {
    echo "pre-push: dagger is required for the gates (https://docs.dagger.io/install)." >&2
    exit 1
  }
  cd "$(git rev-parse --show-toplevel)"
  DAGGER_NO_NAG=1 dagger check -j 1 < /dev/null || {
    echo "pre-push: dagger check failed; refusing the push." >&2
    exit 1
  }
fi

[ -x "$SPRINT_PR" ] || exit 0

# Never let PR bookkeeping block a push. open-sprint-pr exits 1 on a genuine
# GitHub API failure, and a failed `gh api` call is not a reason to refuse to
# publish commits -- the push is the thing that matters, the draft PR is
# convenience. Report the failure, exit 0.
if ! "$SPRINT_PR" "$@"; then
  echo "pre-push: open-sprint-pr failed; push continues (PR bookkeeping is not a gate)." >&2
fi
exit 0
